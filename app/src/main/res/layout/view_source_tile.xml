<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Cámara"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tileSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="RTSP"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tileStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge"
            android:text="● ESPERA"
            android:textColor="@color/text_secondary"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/tileVideoContainer"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:background="#020407">

        <androidx.media3.ui.PlayerView
            android:id="@+id/tilePlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#020407"
            app:resize_mode="fit"
            app:show_buffering="always"
            app:surface_type="texture_view"
            app:use_controller="false" />

        <androidx.camera.view.PreviewView
            android:id="@+id/tilePhonePreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#020407"
            android:visibility="gone"
            app:implementationMode="compatible"
            app:scaleType="fitCenter" />

        <com.fm.centinelaip.DetectionOverlayView
            android:id="@+id/tileOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tileMessage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E6070B14"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:padding="24dp"
            android:text="Lista para conectar"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tileInference"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_badge"
            android:text="YOLO en espera"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/tileConnectButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:text="Conectar"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/tileCaptureButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:text="Capturar"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
